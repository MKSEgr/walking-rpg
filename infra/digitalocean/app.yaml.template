name: walking-rpg-alpha-eu
region: fra
disable_edge_cache: true
disable_email_obfuscation: true
enhanced_threat_control_enabled: true

alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DEPLOYMENT_LIVE
  - rule: DOMAIN_FAILED

ingress:
  rules:
    - match:
        path:
          prefix: /
      component:
        name: backend

services:
  - name: backend
    github:
      repo: MKSEgr/walking-rpg
      branch: master
      deploy_on_push: false
    source_dir: /
    dockerfile_path: backend/Dockerfile
    instance_count: 1
    instance_size_slug: apps-s-1vcpu-1gb
    http_port: 8080
    protocol: HTTP
    health_check:
      initial_delay_seconds: 60
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 2
      failure_threshold: 6
      http_path: /readyz
      port: 8080
    liveness_health_check:
      initial_delay_seconds: 60
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 6
      http_path: /livez
      port: 8080
    termination:
      drain_seconds: 30
      grace_period_seconds: 30
    alerts:
      - rule: CPU_UTILIZATION
        disabled: false
        operator: GREATER_THAN
        value: 80
        window: FIVE_MINUTES
      - rule: MEM_UTILIZATION
        disabled: false
        operator: GREATER_THAN
        value: 85
        window: FIVE_MINUTES
      - rule: RESTART_COUNT
        disabled: false
        operator: GREATER_THAN
        value: 2
        window: FIVE_MINUTES
    envs:
      - key: SPRING_PROFILES_ACTIVE
        value: stage
        scope: RUN_TIME
        type: GENERAL
      - key: POSTGRES_HOST
        value: ${alpha-db.HOSTNAME}
        scope: RUN_TIME
        type: GENERAL
      - key: POSTGRES_PORT
        value: ${alpha-db.PORT}
        scope: RUN_TIME
        type: GENERAL
      - key: POSTGRES_DB
        value: ${alpha-db.DATABASE}
        scope: RUN_TIME
        type: GENERAL
      - key: POSTGRES_USER
        value: ${alpha-db.USERNAME}
        scope: RUN_TIME
        type: GENERAL
      - key: POSTGRES_PASSWORD
        value: ${alpha-db.PASSWORD}
        scope: RUN_TIME
        type: SECRET
      - key: POSTGRES_CA_CERT
        value: ${alpha-db.CA_CERT}
        scope: RUN_TIME
        type: SECRET
      - key: OIDC_ISSUER_URI
        value: "@@OIDC_ISSUER_URI@@"
        scope: RUN_TIME
        type: GENERAL
      - key: OIDC_JWK_SET_URI
        value: "@@OIDC_JWK_SET_URI@@"
        scope: RUN_TIME
        type: GENERAL
      - key: OIDC_AUDIENCE
        value: "@@OIDC_AUDIENCE@@"
        scope: RUN_TIME
        type: GENERAL
      - key: OIDC_DEVICE_CLAIM
        value: https://api.stepbeyond.game/device_id
        scope: RUN_TIME
        type: GENERAL
      - key: OIDC_AUTHENTICATION_TIME_CLAIM
        value: https://api.stepbeyond.game/auth_time
        scope: RUN_TIME
        type: GENERAL
      - key: MANAGEMENT_ADDRESS
        value: 127.0.0.1
        scope: RUN_TIME
        type: GENERAL
      - key: MANAGEMENT_PORT
        value: "8081"
        scope: RUN_TIME
        type: GENERAL
      - key: DB_POOL_SIZE
        value: "4"
        scope: RUN_TIME
        type: GENERAL
      - key: JAVA_TOOL_OPTIONS
        value: -XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
        scope: RUN_TIME
        type: GENERAL

databases:
  - name: alpha-db
    engine: PG
    version: "17"
    production: true
    cluster_name: "@@POSTGRES_CLUSTER_NAME@@"
    db_name: "@@POSTGRES_DATABASE@@"
    db_user: "@@POSTGRES_USER@@"
