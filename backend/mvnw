#!/usr/bin/env sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROPS="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$PROPS" ]; then
  echo "Missing $PROPS" >&2
  exit 1
fi

DISTRIBUTION_URL_COUNT=$(grep -c '^distributionUrl=' "$PROPS" || true)
if [ "$DISTRIBUTION_URL_COUNT" -ne 1 ]; then
  echo "Exactly one distributionUrl must be configured" >&2
  exit 1
fi
DISTRIBUTION_URL=$(sed -n 's/^distributionUrl=//p' "$PROPS")
if [ -z "$DISTRIBUTION_URL" ]; then
  echo "distributionUrl is not configured" >&2
  exit 1
fi

DISTRIBUTION_SHA256_COUNT=$(grep -c '^distributionSha256Sum=' "$PROPS" || true)
if [ "$DISTRIBUTION_SHA256_COUNT" -ne 1 ]; then
  echo "Exactly one distributionSha256Sum must be configured" >&2
  exit 1
fi
DISTRIBUTION_SHA256_SUM=$(sed -n 's/^distributionSha256Sum=//p' "$PROPS")
case "$DISTRIBUTION_SHA256_SUM" in
  *[!0-9a-f]*|'')
    echo "distributionSha256Sum must be 64 lowercase hexadecimal characters" >&2
    exit 1
    ;;
esac
if [ "${#DISTRIBUTION_SHA256_SUM}" -ne 64 ]; then
  echo "distributionSha256Sum must be 64 lowercase hexadecimal characters" >&2
  exit 1
fi

MAVEN_VERSION=$(printf '%s' "$DISTRIBUTION_URL" | sed -n 's#.*apache-maven/\([^/]*\)/.*#\1#p')
if [ -n "${MAVEN_USER_HOME:-}" ]; then
  CACHE_ROOT="$MAVEN_USER_HOME/wrapper/dists"
else
  CACHE_ROOT="${HOME:-$BASE_DIR/.m2}/.m2/wrapper/dists"
fi
INSTALL_DIR="$CACHE_ROOT/apache-maven-$MAVEN_VERSION-$DISTRIBUTION_SHA256_SUM"
MAVEN_BIN="$INSTALL_DIR/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  mkdir -p "$CACHE_ROOT"
  TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t walking-rpg-maven)
  ARCHIVE="$TMP_DIR/maven.zip"

  echo "Downloading Maven $MAVEN_VERSION..." >&2
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DISTRIBUTION_URL" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$DISTRIBUTION_URL" -O "$ARCHIVE"
  else
    echo "curl or wget is required for the first wrapper run" >&2
    rm -rf "$TMP_DIR"
    exit 1
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA256_SUM=$(sha256sum "$ARCHIVE" | sed 's/[[:space:]].*$//')
  elif command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA256_SUM=$(shasum -a 256 "$ARCHIVE" | sed 's/[[:space:]].*$//')
  else
    echo "sha256sum or shasum is required for the first wrapper run" >&2
    rm -rf "$TMP_DIR"
    exit 1
  fi
  if [ "$ACTUAL_SHA256_SUM" != "$DISTRIBUTION_SHA256_SUM" ]; then
    echo "Maven distribution SHA-256 mismatch" >&2
    echo "Expected: $DISTRIBUTION_SHA256_SUM" >&2
    echo "Actual:   $ACTUAL_SHA256_SUM" >&2
    rm -rf "$TMP_DIR"
    exit 1
  fi

  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$ARCHIVE" -d "$TMP_DIR"
  elif command -v jar >/dev/null 2>&1; then
    (cd "$TMP_DIR" && jar xf "$ARCHIVE")
  else
    echo "unzip or jar is required for the first wrapper run" >&2
    rm -rf "$TMP_DIR"
    exit 1
  fi

  chmod 0555 "$TMP_DIR/apache-maven-$MAVEN_VERSION/bin/mvn"
  rm -rf "$INSTALL_DIR"
  mv "$TMP_DIR/apache-maven-$MAVEN_VERSION" "$INSTALL_DIR"
  rm -rf "$TMP_DIR"
fi

exec "$MAVEN_BIN" "$@"
