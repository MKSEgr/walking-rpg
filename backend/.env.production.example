SPRING_PROFILES_ACTIVE=prod

# Protected profiles accept one canonical DNS host and only the exact
# sslmode=verify-full JDBC query. Credentials stay outside the JDBC URL.
# The reviewed DigitalOcean container instead composes this URL from
# POSTGRES_* runtime bindables and installs POSTGRES_CA_CERT outside the JVM
# environment; never store the certificate or password in this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.internal.example:5432/walking_rpg?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=walking_rpg_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-secret-from-the-runtime-secret-store

# Development-only providers are always disabled in prod/stage.
WALKING_RPG_PROVIDERS_PAYMENT=disabled
WALKING_RPG_PROVIDERS_PUSH=disabled

OIDC_ISSUER_URI=https://tenant-name.eu.auth0.com/
OIDC_JWK_SET_URI=https://tenant-name.eu.auth0.com/.well-known/jwks.json
OIDC_AUDIENCE=https://api.stepbeyond.game
OIDC_DEVICE_CLAIM=https://api.stepbeyond.game/device_id
OIDC_AUTHENTICATION_TIME_CLAIM=https://api.stepbeyond.game/auth_time

# Management endpoints stay on a separate loopback listener. A deployed
# monitoring path still needs explicit network-policy and authentication proof.
MANAGEMENT_PORT=8081
MANAGEMENT_ADDRESS=127.0.0.1
