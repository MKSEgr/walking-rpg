POSTGRES_HOST=localhost
POSTGRES_DB=walking_rpg
POSTGRES_USER=walking_rpg
POSTGRES_PASSWORD=walking_rpg_local
POSTGRES_PORT=5432
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Personalized daily goal policy
DAILY_GOAL_POLICY_VERSION=adaptive-median-v1
DAILY_GOAL_LOOKBACK_DAYS=7
DAILY_GOAL_MINIMUM_SAMPLE_DAYS=3
DAILY_GOAL_DEFAULT=6000
DAILY_GOAL_MINIMUM=2000
DAILY_GOAL_MAXIMUM=12000
DAILY_GOAL_GROWTH_PERCENT=5
DAILY_GOAL_ROUNDING_STEP=250

# Backend authentication. The explicit local profile opts into dev-header; base/prod stay JWT.
AUTH_MODE=dev-header
DEMO_ENDPOINTS_ENABLED=true

# Production JWT/OIDC resource-server settings (required with profile prod).
OIDC_ISSUER_URI=https://identity.example.com/realms/walking-rpg
OIDC_JWK_SET_URI=https://identity.example.com/realms/walking-rpg/protocol/openid-connect/certs
OIDC_AUDIENCE=walking-rpg-api
OIDC_ROLES_CLAIM=roles
OIDC_USERNAME_CLAIM=preferred_username
# Must identify one app installation/device and remain stable across access-token refreshes.
OIDC_DEVICE_CLAIM=device_id
OIDC_USER_ROLE=walking-rpg-user
OIDC_ADMIN_ROLE=walking-rpg-admin
OIDC_USER_SCOPE=walking-rpg.user
OIDC_ADMIN_SCOPE=walking-rpg.admin
